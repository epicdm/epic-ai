# E2E Test Environment Variables
# Copy this to .env.test.local for local testing

# Base URL for tests
PLAYWRIGHT_BASE_URL=http://localhost:3000

# UAT Bypass mode (for testing without Clerk)
# Middleware accepts either:
# - UAT_AUTH_BYPASS (canonical, general purpose)
# - E2E_UAT_BYPASS (Playwright E2E tests)
E2E_UAT_BYPASS=true

# Clerk test mode - disables strict key validation in test environment
CLERK_TESTING=true

# Database URL (use test database or mock for E2E tests)
# For local testing with real DB, use valid credentials
DATABASE_URL="postgresql://epic:epicpassword@localhost:5432/epic_ai?schema=public"

# Redis URL (used for build/runtime but mocked in UAT mode)
REDIS_URL="redis://localhost:6379/0"

# Disable external API calls in tests
MOCK_EXTERNAL_APIS=true

# OpenAI (use mock in tests)
OPENAI_API_KEY=sk-test-mock-key

# Skip actual OAuth flows
SKIP_OAUTH_VERIFICATION=true

# Preserve test data for debugging (set to true to keep data after tests)
E2E_PRESERVE_DATA=false

# Clerk (test environment handled by @clerk/testing + clerkSetup() in global.setup.ts)
# Using realistic test key format - Clerk validates key format at import time
CLERK_SECRET_KEY=sk_test_LV2QYhp1Uj3MIy8GRdkS7QfCxrOq18KPZPPIaaDIcr
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bmF0aXZlLWd1cHB5LTM4LmNsZXJrLmFjY291bnRzLmRldiQ
