{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@epic-ai/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@epic-ai/database": [
        "../../packages/database/src/index.ts"
      ],
      "@epic-ai/workers/processors": [
        "../../apps/workers/src/processors/index.ts"
      ],
      "@epic-ai/workers/processors/agent-os": [
        "../../apps/workers/src/processors/agent-os/index.ts"
      ],
      "@epic-ai/workers/types": [
        "../../apps/workers/src/types/index.ts"
      ],
      "@epic-ai/workers/lib": [
        "../../apps/workers/src/lib/index.ts"
      ],
      "@epic-ai/workers/*": [
        "../../apps/workers/src/*/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
