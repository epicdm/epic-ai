# ===========================================
# EPIC AI - Environment Variables
# ===========================================

# Database (DigitalOcean Managed PostgreSQL)
DATABASE_URL="postgresql://user:password@host:25060/epic_ai?sslmode=require"

# Redis (DigitalOcean Managed Redis) - for job queues
REDIS_URL="rediss://default:password@host:25061"

# Clerk Authentication
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/sign-up/welcome"

# OpenAI (Content Generation)
OPENAI_API_KEY=""

# Stripe (Billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# DigitalOcean Spaces (Media Storage)
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_BUCKET="epic-ai-media"
DO_SPACES_REGION="nyc3"
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_CDN_ENDPOINT="https://epic-ai-media.nyc3.cdn.digitaloceanspaces.com"

# Social Platform APIs (Native Integration)
# X/Twitter
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_CALLBACK_URL="${NEXT_PUBLIC_APP_URL}/api/auth/callback/twitter"

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="${NEXT_PUBLIC_APP_URL}/api/auth/callback/linkedin"

# Meta (Facebook/Instagram)
META_APP_ID=""
META_APP_SECRET=""
META_CALLBACK_URL="${NEXT_PUBLIC_APP_URL}/api/auth/callback/meta"

# Google (YouTube + Ads)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="${NEXT_PUBLIC_APP_URL}/api/auth/callback/google"

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_CALLBACK_URL="${NEXT_PUBLIC_APP_URL}/api/auth/callback/tiktok"

# Ad Platforms
META_ADS_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""

# ===========================================
# Voice AI (LiveKit + Magnus Billing)
# ===========================================
# LiveKit Server
LIVEKIT_URL="wss://your-livekit.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Magnus Billing (Telephony)
MAGNUS_API_URL="https://your-magnus-server.com/mbilling/api"
MAGNUS_API_KEY=""
MAGNUS_TENANT_ID=""
MAGNUS_DEFAULT_RATE=""
MAGNUS_DEFAULT_TRUNK=""

# Voice Service (internal)
# Local development: http://localhost:5000
# Production (DigitalOcean): https://epic-ai-platform-zcjiu.ondigitalocean.app/voice
VOICE_SERVICE_URL="http://localhost:5000"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Token Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=""

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE_AI="false"
NEXT_PUBLIC_ENABLE_ADS="true"

# ===========================================
# Live Session Management (Transfer Tool Adapter Pack v1)
# ===========================================
# Session TTL in Redis (seconds, default 24 hours)
# SESSION_TTL_SECONDS=86400

# ===========================================
# Telephony Callback Configuration (Optional)
# ===========================================
# BullMQ Queue Configuration (matches workers)
# CALLBACK_QUEUE_NAME="telephony-callback"
# BULLMQ_PREFIX="epic"

# Callback Job Retry Configuration
# CALLBACK_JOB_ATTEMPTS=3
# CALLBACK_JOB_BACKOFF_MS=5000

# ===========================================
# Development & Testing (Local / Playwright E2E)
# ===========================================
# UAT Auth Bypass - DEVELOPMENT ONLY
# Allows testing without Clerk authentication in development mode
# Canonical variable: UAT_AUTH_BYPASS (general purpose, unit/integration tests)
# Alternative variable: E2E_UAT_BYPASS (Playwright E2E tests - both supported)
# UAT_AUTH_BYPASS="false"
# E2E_UAT_BYPASS="false"
