;
; Asterisk Manager Interface (AMI) Configuration
; File: /etc/asterisk/manager.conf
;
; This configuration enables AMI for Epic AI workers to originate outbound calls.
;

[general]
enabled = yes
port = 5038
bindaddr = 0.0.0.0

;
; Manager user for Epic AI workers
; Used by BullMQ callback processor to trigger outbound calls
;
[epic_ami]
secret = CHANGE_ME_STRONG
; Read permissions
read = system,call,log,verbose,command,agent,user,originate
; Write permissions
write = system,call,log,verbose,command,agent,user,originate
; Network ACLs (tighten to your workers host IP)
permit = 10.0.0.0/8
permit = 172.16.0.0/12
permit = 192.168.0.0/16
; deny = 0.0.0.0/0.0.0.0

;
; Security Notes:
; 1. Change the default secret to a strong password
; 2. Restrict permit lines to specific worker IPs
; 3. Use firewall rules to restrict access to port 5038
; 4. Consider using TLS for AMI connections (tlsenable=yes)
; 5. Monitor AMI access logs regularly
;

;
; Apply configuration:
; asterisk -rx "manager reload"
;
; Test AMI access:
; telnet localhost 5038
; Action: Login
; Username: epic_ami
; Secret: CHANGE_ME_STRONG
;
