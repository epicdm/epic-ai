# Epic AI Voice Service - Environment Variables

# Server Configuration
PORT=8000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Magnus Billing Configuration
MAGNUS_API_KEY=your-magnus-api-key
MAGNUS_API_SECRET=your-magnus-api-secret
MAGNUS_PUBLIC_URL=https://voice00.epic.dm
MAGNUS_SIP_SERVER=voice00.epic.dm
MAGNUS_SIP_IP=157.245.83.64

# Magnus CRM/Billing Tool Adapter (v1)
# Used by Tool Node Runtime for magnus.lookupCustomer, magnus.createLead, magnus.createCallLog
MAGNUS_BASE_URL=https://your-magnus-url
# Timeout for Magnus API calls (seconds)
MAGNUS_TIMEOUT_SECS=8
# Number of retry attempts (0 = no retries)
MAGNUS_RETRY=0

# Database (shared with Epic AI)
DATABASE_URL=postgresql://user:password@localhost:5432/epic_ai

# Redis (for session/cache if needed)
REDIS_URL=redis://localhost:6379

# OpenAI (for agent responses)
OPENAI_API_KEY=sk-your-openai-key

# ElevenLabs (for 75ms ultra-low latency TTS)
ELEVEN_API_KEY=your-elevenlabs-api-key

# Cartesia (alternative TTS provider)
CARTESIA_API_KEY=your-cartesia-api-key

# Deepgram (for STT and optional TTS)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Epic AI Runtime Integration
# Set USE_RUNTIME_LLM=true to use the full agent runtime instead of direct OpenAI
USE_RUNTIME_LLM=false
RUNTIME_API_URL=http://localhost:3000/api/runtime/voice
VOICE_RUNTIME_API_KEY=your-runtime-api-key

# Inbound Call Guard (fail-closed safety gate)
# Base URL for the Epic AI web app (health-check endpoint)
EPIC_WEB_BASE_URL=http://localhost:3000
# API key for authenticating with the web app (optional, same as VOICE_RUNTIME_API_KEY)
EPIC_RUNTIME_API_KEY=your-runtime-api-key
# Timeout for health-check requests (seconds)
EPIC_HEALTHCHECK_TIMEOUT_S=3.0
# Number of retry attempts on health-check failure
EPIC_HEALTHCHECK_RETRIES=1
# Custom fallback message when calls are blocked
EPIC_CALL_FALLBACK_TEXT=Thanks for calling. This line is temporarily unavailable. Please try again shortly.
# Enable debug logging for health checks
EPIC_HEALTHCHECK_DEBUG=false

# Route-to-agent Runtime Adapter v1 (optional)
# If you want to route calls through the Epic AI Agent Runtime instead of direct OpenAI
# Max conversation turns before auto-hangup
EPIC_RUNTIME_MAX_TURNS=100
# Timeout per runtime turn (seconds)
EPIC_RUNTIME_TURN_TIMEOUT=30.0
# Enable hangup keyword detection (goodbye, bye, etc.)
EPIC_RUNTIME_ENABLE_HANGUP_KEYWORDS=true
# Fallback message on runtime errors
EPIC_RUNTIME_FALLBACK_TEXT=I'm having trouble processing your request. Please try again later.

# DTMF Telephony Configuration (v1)
# DTMF-first call flow with Asterisk dialplan integration
# Timeout in seconds for DTMF input
EPIC_DTMF_TIMEOUT_S=7
# Number of retry attempts before fallback to voicemail
EPIC_DTMF_RETRIES=2

# Recording Configuration
# Enable voicemail recording fallback when DTMF times out
EPIC_REC_ENABLE=true
# Silence threshold in seconds (stops recording after this much silence)
EPIC_REC_SILENCE_S=20
# Maximum recording duration in seconds
EPIC_REC_MAX_S=45
# Directory path for storing recordings
EPIC_REC_DIR=/tmp/epic-recordings

# Callback Queue Configuration (v1)
# Timeout for callback enqueue API calls (seconds)
CALLBACK_ENQUEUE_TIMEOUT=5.0

# FastAGI Server Configuration (for outbound callbacks)
# Host to bind FastAGI server (default: 0.0.0.0 = all interfaces)
FASTAGI_HOST=0.0.0.0
# Port to bind FastAGI server (default: 4573)
FASTAGI_PORT=4573
# NOTE: Ensure this port is accessible from Asterisk server
