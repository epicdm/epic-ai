# Epic AI Voice Service - Environment Variables

# Server Configuration
PORT=8000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Magnus Billing Configuration
MAGNUS_API_KEY=your-magnus-api-key
MAGNUS_API_SECRET=your-magnus-api-secret
MAGNUS_PUBLIC_URL=https://voice00.epic.dm
MAGNUS_SIP_SERVER=voice00.epic.dm
MAGNUS_SIP_IP=157.245.83.64

# Database (shared with Epic AI)
DATABASE_URL=postgresql://user:password@localhost:5432/epic_ai

# Redis (for session/cache if needed)
REDIS_URL=redis://localhost:6379

# OpenAI (for agent responses)
OPENAI_API_KEY=sk-your-openai-key

# ElevenLabs (for 75ms ultra-low latency TTS)
ELEVEN_API_KEY=your-elevenlabs-api-key

# Cartesia (alternative TTS provider)
CARTESIA_API_KEY=your-cartesia-api-key

# Deepgram (for STT and optional TTS)
DEEPGRAM_API_KEY=your-deepgram-api-key
