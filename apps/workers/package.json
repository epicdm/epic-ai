{
  "name": "@epic-ai/workers",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "lib": [
        "./dist/lib/index.d.ts"
      ],
      "types": [
        "./dist/types/index.d.ts"
      ],
      "queues": [
        "./dist/queues/index.d.ts"
      ],
      "runtime": [
        "./dist/runtime/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.mjs",
      "require": "./dist/lib/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./queues": {
      "types": "./dist/queues/index.d.ts",
      "import": "./dist/queues/index.mjs",
      "require": "./dist/queues/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/scheduler.ts src/lib/index.ts src/types/index.ts src/queues/index.ts src/runtime/index.ts --format esm,cjs",
    "build:types": "tsup src/index.ts src/scheduler.ts src/lib/index.ts src/types/index.ts src/queues/index.ts src/runtime/index.ts --format esm,cjs --dts",
    "start": "node dist/index.js",
    "schedule": "node dist/scheduler.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@epic-ai/database": "workspace:*",
    "@epic-ai/shared": "workspace:*",
    "bullmq": "^5.7.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.8.2",
    "node-cron": "^4.2.1",
    "openai": "^6.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cheerio": "^1.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
