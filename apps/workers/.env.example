# Epic AI Background Workers - Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/epic_ai

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Asterisk AMI Configuration (for outbound callbacks)
# AMI host (Asterisk server IP or hostname)
ASTERISK_AMI_HOST=asterisk.example.com
# AMI port (default: 5038)
ASTERISK_AMI_PORT=5038
# AMI username (from manager.conf)
ASTERISK_AMI_USER=epic_ami
# AMI password (from manager.conf)
ASTERISK_AMI_PASS=CHANGE_ME_STRONG

# Asterisk Outbound Configuration
# PJSIP trunk endpoint name for outbound calls
ASTERISK_OUTBOUND_TRUNK=trunk
# Caller ID for outbound calls
ASTERISK_OUTBOUND_CID=+17675550000

# Voice Service FastAGI Configuration
# Where voice-service FastAGI is reachable FROM Asterisk
# (Use internal hostname/IP if in same network/docker-compose)
VOICE_SERVICE_FASTAGI_HOST=voice-service
VOICE_SERVICE_FASTAGI_PORT=4573

# Asterisk Originate Configuration (Callback Worker v1)
# Dialplan context for originated calls
ASTERISK_ORIGINATE_CONTEXT=from-internal
# Dialplan priority
ASTERISK_ORIGINATE_PRIORITY=1
# Caller ID label for originated calls
ASTERISK_ORIGINATE_CALLERID=EPIC
# Originate timeout in milliseconds
ASTERISK_ORIGINATE_TIMEOUT_MS=30000
# Channel technology prefix (PJSIP/, SIP/, Local/, etc.)
ASTERISK_ORIGINATE_CHANNEL_PREFIX=PJSIP/

# BullMQ Configuration
# Queue name for callback jobs
CALLBACK_QUEUE_NAME=telephony-callback
# Redis key prefix for BullMQ
BULLMQ_PREFIX=epic

# AMI Event Listener v1 (Lifecycle Tracking)
# Ping interval for keepalive (milliseconds)
ASTERISK_AMI_PING_INTERVAL_MS=15000
# Debug mode (logs all events)
ASTERISK_AMI_DEBUG=false

# Session Management (Transfer Tool Adapter Pack v1)
# TTL for session data in Redis (seconds, default 24 hours = 86400)
SESSION_TTL_SECONDS=86400

# Handoff Configuration
# Default dialplan context for handoff transfers
HANDOFF_DEFAULT_TARGET=sales_queue
# Default dialplan extension for handoff
HANDOFF_DEFAULT_EXTEN=1
# Default dialplan priority for handoff
HANDOFF_DEFAULT_PRIORITY=1

# AMI Redirect Configuration (Transfer Tool Adapter Pack v1)
# Timeout for AMI redirect action (milliseconds)
AMI_REDIRECT_TIMEOUT_MS=10000
